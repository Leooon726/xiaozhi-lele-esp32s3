{
    "manufacturer": "lckfb",
    "type": "lichuang-dev",
    "target": "esp32s3",
    "builds": [
        {
            "name": "lichuang-dev",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y"
            ]
        },
        {
            "name": "lichuang-dev-lele",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y"
            ]
        },
        {
            "name": "lichuang-dev-lele-music",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_LICHUANG_TF_MUSIC=y",
                "CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_LICHUANG_USB_STORAGE=y",
                "CONFIG_TINYUSB_DESC_PRODUCT_STRING=\"Lele SD Transfer\"",
                "CONFIG_TINYUSB_DESC_MSC_STRING=\"SD Card\"",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16",
                "CONFIG_ESP_WIFI_RX_BA_WIN=6",
                "CONFIG_LWIP_UDP_RECVMBOX_SIZE=32",
                "CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64",
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y"
            ]
        },
        {
            "name": "lichuang-dev-lele-music-debug",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_LICHUANG_TF_MUSIC=y",
                "CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_LICHUANG_TF_MUSIC_DEBUG=y",
                "CONFIG_LICHUANG_USB_STORAGE=y",
                "CONFIG_TINYUSB_DESC_PRODUCT_STRING=\"Lele SD Transfer\"",
                "CONFIG_TINYUSB_DESC_MSC_STRING=\"SD Card\"",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16",
                "CONFIG_ESP_WIFI_RX_BA_WIN=6",
                "CONFIG_LWIP_UDP_RECVMBOX_SIZE=32",
                "CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64",
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y"
            ]
        }
    ]
}
